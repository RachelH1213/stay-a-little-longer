# Which model writes Juno's lines: zhipu (default) | anthropic | openai
JUNO_PROVIDER=

ZHIPU_API_KEY=
# Only for an international z.ai key: https://api.z.ai/api/paas/v4/chat/completions
ZHIPU_API_URL=
# Optional: models to try in order (default glm-4.5-flash,glm-4.7-flash)
ZHIPU_MODEL=

ANTHROPIC_API_KEY=
# Optional (default claude-opus-5-5), e.g. claude-haiku-5-5 or claude-sonnet-5-5
ANTHROPIC_MODEL=

OPENAI_API_KEY=
# Required for OpenAI: copy the model name from OpenAI's dashboard
OPENAI_MODEL=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
